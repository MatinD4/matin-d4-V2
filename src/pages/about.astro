---
import MainLayout from "../layouts/MainLayout.astro";
import { getSiteContent } from "../lib/content";
const content = await getSiteContent();
const { profile, pages, games } = content;
---
<MainLayout title={`About — ${profile.brand}`} description={pages.aboutIntro}>
  <section class="container-shell py-16 sm:py-24">
    <p class="eyebrow mb-3">A little about me</p><h1 class="section-title text-5xl sm:text-6xl">The person behind <span class="lime">D4.</span></h1>
    <div class="mt-8 grid gap-6 md:grid-cols-[1.2fr_.8fr]">
      <article class="panel p-6 sm:p-8"><h2 class="mb-4 text-xl font-bold">Who am I?</h2><p class="leading-8 text-slate-300">{profile.bio}</p><p class="mt-4 leading-8 text-slate-400">{profile.aboutExtra}</p>{profile.location && <p class="mt-4 text-sm text-slate-500">Based in {profile.location}</p>}</article>
      <article class="panel p-6 sm:p-8"><p class="eyebrow mb-3">My mindset</p><p class="whitespace-pre-line text-2xl font-semibold leading-snug">{pages.aboutMindset.split("\n").map((line,i)=><span class="block">{i===1?<span class="lime">{line}</span>:line}</span>)}</p><p class="mt-5 text-sm leading-6 text-slate-400">This site will grow alongside my skills and projects.</p></article>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <section class="panel p-6"><h2 class="mb-5 text-xl font-bold">Skills & tools</h2><div class="grid grid-cols-2 gap-3 sm:grid-cols-3">{profile.skills.map(skill => <div class="flex min-w-0 items-center gap-3 rounded-xl border border-white/10 bg-white/[.02] p-3 transition hover:border-[var(--lime)]/40"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-[var(--lime)]/25 bg-[var(--lime)]/[.07] font-mono text-xs font-bold lime">{skill.split(/[ +.-]/).map(part=>part[0]).join("").slice(0,2).toUpperCase()}</span><span class="truncate text-sm">{skill}</span></div>)}</div></section>
      <section class="panel p-6"><h2 class="mb-5 text-xl font-bold">Things I like</h2><div class="grid grid-cols-2 gap-3">{profile.interests.map(item => <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[.02] p-3 transition hover:border-[var(--lime)]/40"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-white/10 font-mono text-xs font-bold text-slate-300">✳</span><span class="text-sm">{item}</span></div>)}</div></section>
    </div>
    <section class="mt-6"><div class="mb-5"><p class="eyebrow mb-2">After the build</p><h2 class="section-title">Games I play<span class="lime">.</span></h2><p class="mt-2 text-sm text-slate-400">A few worlds I keep coming back to.</p></div><div class="grid gap-4 md:grid-cols-3">{games.map((game,index) => <a href={game.url || "#"} target={game.url ? "_blank" : undefined} rel={game.url ? "noreferrer" : undefined} class="group overflow-hidden rounded-2xl border border-white/10 bg-[#11151a] transition hover:-translate-y-1 hover:border-[var(--lime)]/40"><div class="relative grid h-36 place-items-center overflow-hidden border-b border-white/10 bg-[radial-gradient(circle_at_50%_45%,rgba(184,243,107,.12),transparent_55%),#0d1014]"><span class="absolute inset-0 opacity-30" style="background-image:linear-gradient(135deg,transparent 49.5%,rgba(255,255,255,.06) 50%,transparent 50.5%);background-size:18px 18px"></span><span class="relative grid h-16 w-16 place-items-center rounded-2xl border border-[var(--lime)]/35 bg-[#0b0d10]/80 font-mono text-xl font-black tracking-tight lime shadow-[0_0_40px_rgba(184,243,107,.08)]">{game.mark}</span><span class="absolute bottom-3 right-4 font-mono text-[10px] tracking-[.2em] text-slate-600">0{index+1}</span></div><div class="p-4"><h3 class="font-semibold group-hover:text-[var(--lime)]">{game.name}</h3><p class="mt-1 text-xs text-slate-500">{game.subtitle}</p></div></a>)}</div></section>
    <section class="panel mt-6 p-6"><h2 class="mb-3 text-xl font-bold">On repeat</h2><p class="text-slate-400">Artists I enjoy listening to:</p><div class="mt-4 flex flex-wrap gap-2">{profile.musicArtists.map(artist => <span class="rounded-full bg-white/[.05] px-4 py-2 text-sm">{artist}</span>)}</div></section>
  </section>
</MainLayout>
