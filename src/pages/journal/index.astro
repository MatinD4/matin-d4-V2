---
import MainLayout from "../../layouts/MainLayout.astro";
import { getSiteContent } from "../../lib/content";
const content = await getSiteContent();
const posts = content.posts.filter(post => post.published).sort((a,b)=>b.date.localeCompare(a.date));
---
<MainLayout title={`Journal — ${content.profile.brand}`} description="Notes, experiments, and things learned by Matin D4.">
  <section class="container-shell py-16 sm:py-24">
    <p class="eyebrow mb-3">Notes from the build log</p><h1 class="section-title text-5xl sm:text-6xl">The <span class="lime">journal.</span></h1>
    <p class="mt-5 max-w-2xl leading-7 text-slate-400">Small notes about projects, code, experiments, and what I'm learning along the way.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">{posts.map(post => <article class="panel overflow-hidden">{post.cover && <img src={post.cover} alt="" class="aspect-[16/9] w-full object-cover" loading="lazy" />}<div class="p-6"><p class="text-xs text-slate-500">{post.date}</p><h2 class="mt-2 text-xl font-bold">{post.title}</h2><p class="mt-3 text-sm leading-6 text-slate-400">{post.excerpt}</p><a class="mt-5 inline-block text-sm font-semibold lime" href={`/journal/${encodeURIComponent(post.slug)}`}>Read post ↗</a></div></article>)}</div>
    {posts.length === 0 && <div class="panel mt-8 p-6 text-slate-400">No posts published yet. Check back later.</div>}
  </section>
</MainLayout>
