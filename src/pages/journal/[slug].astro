---
import MainLayout from "../../layouts/MainLayout.astro";
import { getSiteContent } from "../../lib/content";
export const prerender = false;
const { slug } = Astro.params;
const content = await getSiteContent();
const post = content.posts.find(item => item.published && item.slug === slug);
if (!post) return Astro.redirect("/journal", 302);
---
<MainLayout title={`${post.title} — ${content.profile.brand}`} description={post.excerpt}>
  <article class="container-shell max-w-3xl py-16 sm:py-24">
    <a href="/journal" class="text-sm lime">← Back to journal</a><p class="eyebrow mt-8">{post.date}</p><h1 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">{post.title}</h1><p class="mt-5 text-lg leading-8 text-slate-400">{post.excerpt}</p>
    {post.cover && <img src={post.cover} alt="" class="mt-8 max-h-[460px] w-full rounded-2xl object-cover" />}
    <div class="panel mt-8 p-6 sm:p-8"><div class="whitespace-pre-wrap break-words text-base leading-8 text-slate-300">{post.body}</div>{post.tags.length>0 && <div class="mt-8 flex flex-wrap gap-2">{post.tags.map(tag=><span class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-400">{tag}</span>)}</div>}</div>
  </article>
</MainLayout>
